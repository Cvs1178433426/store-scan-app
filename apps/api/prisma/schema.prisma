generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  GENERAL
}

enum OrganizationRole {
  OWNER
  ADMIN
  MANAGER
  BUYER
  RECEIVER
  INVENTORY
  PICKER
  CHECKER
  SHIPPING
  ACCOUNTING
  VIEWER
}

enum SiteType {
  STORE
  WAREHOUSE
  DISTRIBUTION_CENTER
  OFFICE
  OTHER
}

enum ProductIdentifierType {
  UPC
  EAN
  GTIN
  NDC
  CUSTOMER_SKU
  MANUFACTURER_ITEM
  OTHER
}

enum ProductPackagingLevel {
  EACH
  INNER
  CASE
  PALLET
  OTHER
}

enum InventoryTransactionType {
  RECEIVE
  SHIP
  TRANSFER_IN
  TRANSFER_OUT
  DAMAGE
  RETURN_TO_VENDOR
  COUNT_ADJUSTMENT
  MANUAL_ADJUSTMENT
}

enum BarcodeSource {
  GENERATED
  EXISTING
  MATTER
  SERIAL
}

enum ItemType {
  CONSUMABLE
  ASSET
}

enum ItemCondition {
  NEW
  IN_USE
  NEEDS_REPAIR
  RETIRED
}

enum BarcodeSymbology {
  EAN13
  UPCA
  CODE128
  QR
  DATA_MATRIX
  OTHER
}

enum StockMovementReason {
  RESTOCK
  CONSUME
  ADJUST
}

enum AuditSessionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum AuditCheckStatus {
  PENDING
  FOUND
  UNEXPECTED
}

enum StoreCountSessionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model User {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  employeeNumber  String?  @unique
  passwordHash    String
  recoveryPinHash String?
  role            UserRole @default(GENERAL)
  isActive        Boolean  @default(true)
  tokenVersion    Int      @default(0)
  createdAt       DateTime @default(now())

  createdItems             Item[]                     @relation("ItemCreatedBy")
  movements                StockMovement[]
  pushSubscriptions        PushSubscription[]
  auditSessions            AuditSession[]
  storeCountSessions       StoreCountSession[]
  storeCountEntriesCounted StoreCountEntry[]          @relation("StoreCountEntryCounter")
  storeCountScanLogs       StoreCountScanLog[]        @relation("StoreCountScanActor")
  organizationMemberships  OrganizationMembership[]
  inventoryTransactions   InventoryTransaction[]      @relation("InventoryTransactionActor")

  @@index([isActive])
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships           OrganizationMembership[]
  sites                 Site[]
  products              Product[]
  productIdentifiers    ProductIdentifier[]
  inventoryTransactions InventoryTransaction[]

  @@index([isActive])
}

model OrganizationMembership {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(VIEWER)
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId, isActive])
  @@index([organizationId, role, isActive])
}
