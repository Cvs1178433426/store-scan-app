generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  GENERAL
}

enum BarcodeSource {
  GENERATED
  EXISTING
  MATTER
  SERIAL
}

enum ItemType {
  CONSUMABLE
  ASSET
}

enum ItemCondition {
  NEW
  IN_USE
  NEEDS_REPAIR
  RETIRED
}

enum BarcodeSymbology {
  EAN13
  UPCA
  CODE128
  QR
  DATA_MATRIX
  OTHER
}

enum StockMovementReason {
  RESTOCK
  CONSUME
  ADJUST
}

enum AuditSessionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum AuditCheckStatus {
  PENDING
  FOUND
  UNEXPECTED
}

enum StoreCountSessionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(GENERAL)
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())

  createdItems       Item[]              @relation("ItemCreatedBy")
  movements          StockMovement[]
  pushSubscriptions  PushSubscription[]
  auditSessions      AuditSession[]
  storeCountSessions StoreCountSession[]
}

model Location {
  id        String   @id @default(cuid())
  name      String
  parentId  String?
  photoUrl  String?
  notes     String?
  createdAt DateTime @default(now())

  parent        Location?      @relation("LocationTree", fields: [parentId], references: [id], onDelete: Cascade)
  children      Location[]     @relation("LocationTree")
  items         Item[]
  auditSessions AuditSession[]
}

model Category {
  id       String  @id @default(cuid())
  name     String
  parentId String?
  isActive Boolean @default(true)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Category[] @relation("CategoryTree")
  items    Item[]
  products Product[]
}

model Item {
  id                 String    @id @default(cuid())
  name               String
  manufacturer       String?
  description        String?
  packageSize        String?
  quantity           Int       @default(1)
  unit               String?
  locationId         String?
  categoryId         String?
  minQuantity        Int?
  purchaseDate       DateTime?
  price              Float?
  currency           String?
  expiryDate         DateTime?
  expiryNotifiedAt   DateTime?
  warrantyExpiresAt  DateTime?
  warrantyNotifiedAt DateTime?
  photoUrl           String?
  notes              String?
  wanted             Boolean   @default(false)
  isActive           Boolean   @default(true)
  itemType           ItemType      @default(CONSUMABLE)
  condition          ItemCondition?
  createdById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?
  lastAuditedAt      DateTime?

  location           Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  category           Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy          User?              @relation("ItemCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  barcodes           Barcode[]
  attachments        Attachment[]
  movements          StockMovement[]
  maintenanceRecords MaintenanceRecord[]
  auditChecks        AuditCheck[]

  @@index([locationId])
  @@index([categoryId])
  @@index([expiryDate])
  @@index([isActive])
}

model Barcode {
  id         String            @id @default(cuid())
  itemId     String
  value      String
  symbology  BarcodeSymbology  @default(OTHER)
  source     BarcodeSource     @default(EXISTING)
  isPrimary  Boolean           @default(false)
  createdAt  DateTime          @default(now())

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([value])
}

model ProductLookupCache {
  barcodeValue String   @id
  name         String?
  brand        String?
  imageUrl     String?
  provider     String?
  fetchedAt    DateTime @default(now())
  rawPayload   Json?
}

model StockMovement {
  id         String              @id @default(cuid())
  itemId     String
  delta      Int
  reason     StockMovementReason @default(ADJUST)
  userId     String?
  occurredAt DateTime            @default(now())

  item Item  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([itemId, occurredAt])
}

model MaintenanceRecord {
  id          String   @id @default(cuid())
  itemId      String
  date        DateTime
  description String
  cost        Float?
  currency    String?
  createdAt   DateTime @default(now())

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, date])
}

model Attachment {
  id         String   @id @default(cuid())
  filePath   String
  mimeType   String
  uploadedAt DateTime @default(now())

  itemId String?
  item   Item?   @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  locale    String   @default("ko")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditSession {
  id              String             @id @default(cuid())
  locationId      String
  includeChildren Boolean            @default(true)
  status          AuditSessionStatus @default(ACTIVE)
  startedById     String?
  startedAt       DateTime           @default(now())
  completedAt     DateTime?

  location  Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  startedBy User?    @relation(fields: [startedById], references: [id], onDelete: SetNull)
  checks    AuditCheck[]

  @@index([locationId, status])
  @@index([startedById])
}

model AuditCheck {
  id               String           @id @default(cuid())
  sessionId        String
  itemId           String
  expectedQuantity Int
  actualQuantity   Int?
  status           AuditCheckStatus @default(PENDING)
  checkedAt        DateTime?

  session AuditSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  item    Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([sessionId, itemId])
  @@index([sessionId, status])
}

model StoreLocation {
  id        String   @id @default(cuid())
  code      String
  name      String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  entries StoreCountEntry[]

  @@unique([code])
  @@index([isActive, sortOrder])
}

model Product {
  id           String    @id @default(cuid())
  barcodeValue String?
  name         String
  manufacturer String?
  description  String?
  packageSize  String?
  imageUrl     String?
  categoryId   String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  category Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  entries  StoreCountEntry[]

  @@unique([barcodeValue])
  @@index([categoryId])
  @@index([isActive])
}

model StoreCountSession {
  id          String                  @id @default(cuid())
  name        String?
  status      StoreCountSessionStatus @default(ACTIVE)
  startedById String?
  startedAt   DateTime                @default(now())
  completedAt DateTime?
  updatedAt   DateTime                @updatedAt

  startedBy User?             @relation(fields: [startedById], references: [id], onDelete: SetNull)
  entries   StoreCountEntry[]

  @@index([startedById, status])
  @@index([status, startedAt])
}

model StoreCountEntry {
  id           String   @id @default(cuid())
  sessionId    String
  productId    String?
  barcodeValue String
  locationId   String
  quantity     Int      @default(1)
  scannedAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  session  StoreCountSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  product  Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  location StoreLocation     @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([sessionId, locationId, barcodeValue])
  @@index([sessionId, locationId])
  @@index([sessionId, barcodeValue])
  @@index([productId])
  @@index([locationId])
}
